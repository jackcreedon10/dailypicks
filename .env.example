# Supabase (Project Settings -> API). The secret key is server-only; never expose it to the browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=

# Alpaca market data (free account at alpaca.markets -> API keys). Leave blank to use simulated prices.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_FEED=iex

# Shared secret the scheduler sends as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Mock mode only: override session hours (New York time) to test the live game anytime, e.g. 00:00-23:59.
# MOCK_SESSION=09:30-16:00
